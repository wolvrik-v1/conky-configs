#!/bin/bash
# WindingRings -- start / stop / restart the WindingRings conky
# (glass "Air Clock" + date + winding meters; conky-only, no companion processes)
set -u

DIR="$HOME/.conky/WindingRings"
RC="$DIR/WindingRingsrc"
LOG="$DIR/WindingRings.log"
PAT='[c]onky .*WindingRingsrc'

start() {
    if pgrep -f "$PAT" >/dev/null 2>&1; then
        echo "WindingRings already running"
        return 0
    fi
    setsid conky -d -c "$RC" </dev/null >>"$LOG" 2>&1 &
    disown
    echo "WindingRings started"
}

stop() {
    pkill -f "$PAT" 2>/dev/null
    echo "WindingRings stopped"
}

status() {
    if pgrep -f "$PAT" >/dev/null 2>&1; then
        echo "WindingRings running (pid $(pgrep -f "$PAT" | head -1))"
    else
        echo "WindingRings not running"
    fi
}

case "${1:-start}" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  status ;;
    *)       echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
