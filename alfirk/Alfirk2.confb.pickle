conky.config = {
    alignment = 'bottom_left',
    gap_x = 20,
    gap_y = 10,
    maximum_width = 450,
    minimum_height = 210,
    minimum_width = 450,
    use_xft = true,
    override_utf8_locale = true,
    font = 'Comfortaa:size=9',
    default_color = '#787878',
    default_outline_color = '#787878',
    default_shade_color = '#787878',
    color0 = '#787878',
    color1 = '#787878',
    background = false,
    border_width = 0,
    draw_borders = false,
    draw_graph_borders = false,
    draw_outline = false,
    draw_shades = false,
    draw_blended = false,
    own_window = true,
    own_window_colour = '000000',
    own_window_class = 'Conky',
    own_window_argb_visual = true,
    own_window_argb_value = 0,
    own_window_type = 'dock',
    own_window_transparent = true,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    stippled_borders = 0,
    cpu_avg_samples = 2,
    net_avg_samples = 2,
    double_buffer = true,
    out_to_console = false,
    out_to_stderr = false,
    extra_newline = false,
    update_interval = 0.05,
    uppercase = false,
    use_spacer = 'none',
    show_graph_scale = false,
    show_graph_range = false,
    default_bar_height = 6
}

conky.text = [[
${if_running pianobar}${execi 60 ~/.conky/Alfirk/scripts/start_cava_reader.pickle.sh}${offset 2}${voffset 2}${font feather:bold:size=20}${color0}${font}
${voffset 12}${offset 4}${font Comfortaa:bold:size=9}${color0}Now Playing:${font}
${GOTO 137}${voffset 20}${font Comfortaa:size=9}${exec cat ~/.config/pianobar/artist 2>/dev/null}
${GOTO 137}${voffset 4}${color0}${font Comfortaa:bold:size=10}${exec cat ~/.config/pianobar/title 2>/dev/null}${font}
${GOTO 137}${voffset 4}${font Comfortaa:size=9}${exec cat ~/.config/pianobar/album 2>/dev/null}
${GOTO 137}${voffset 4}${font Monospace:bold:size=14}${color1}${execi 1 ~/.conky/Alfirk/scripts/pianobar_progress.sh}
${image ~/.config/pianobar/coverArt.jpg -f 120 -p 4,60 -s 125x125}
${voffset -25}${GOTO 137}${font Monospace:bold:size=14}${color1}${cat /tmp/cava_bars.txt}${font}
${else}${execi 60 pkill -x cava 2>/dev/null; pkill -f 'scripts/cava_reader.pickle.sh' 2>/dev/null}${font feather:bold:size=20}${voffset 125}${color0}${font}
${font Comfortaa:bold:size=9}${color0}${voffset 20}No Music Playing${font}${endif}
]]

