#!/bin/bash
# MetalSysMonitor start/stop/restart wrapper (conky-only)

DIR="$HOME/.conky/metalsysmonitor"
RC="$DIR/metalsysmonitorrc"

case "$1" in
    start)
        if pgrep -f "[m]etalsysmonitorrc" >/dev/null 2>&1; then
            echo "metalsysmonitor already running"
        else
            setsid conky -d -c "$RC" </dev/null >>"$DIR/metalsysmonitor.log" 2>&1 &
            disown
            sleep 1
            echo "metalsysmonitor started"
        fi
        ;;
    stop)
        pkill -f "[m]etalsysmonitorrc" 2>/dev/null
        echo "metalsysmonitor stopped"
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "usage: $0 {start|stop|restart}"
        ;;
esac