#!/bin/bash
# brasspianobar -- start / stop / restart the round brass now-playing widget.
# conky-only wrapper: the renderer reads the shared pianobar-widget status cache
# (~/.cache/conky/pianobar-widget.status) directly, so there is no companion
# process to babysit here.
set -u

DIR="$HOME/.conky/brasspianobar"
RC="$DIR/brasspianobarrc"
LOG="$DIR/brasspianobar.log"
PAT='[c]onky .*brasspianobarrc'

start() {
    if pgrep -f "$PAT" >/dev/null 2>&1; then
        echo "brasspianobar already running"
        return 0
    fi
    setsid conky -d -c "$RC" </dev/null >>"$LOG" 2>&1 &
    disown
    echo "brasspianobar started"
}

stop() {
    pkill -f "$PAT" 2>/dev/null
    echo "brasspianobar stopped"
}

status() {
    if pgrep -f "$PAT" >/dev/null 2>&1; then
        echo "brasspianobar running (pid $(pgrep -f "$PAT" | head -1))"
    else
        echo "brasspianobar not running"
    fi
}

case "${1:-start}" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  status ;;
    *)       echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
