#!/bin/bash
# zenclock - start / stop / restart the zen meditation clock + timer
#
# The timer control overlay (btnzen) is owned by conky: conkyzen.lua
# (spawn_button) launches/refreshes it whenever conky starts, and the
# button self-exits ~15s after conky disappears. So this wrapper only
# has to manage conky - usable with conky-manager as well.

DIR="$HOME/.conky/zenclock"
LOG="$DIR/btnzen.log"

case "$1" in
    start)
        if pgrep -f "[z]enclockrc" >/dev/null 2>&1; then
            echo "zenclock already running"
        else
            setsid conky -d -c "$DIR/conkyzenrc" </dev/null >>"$LOG" 2>&1 &
            disown
            sleep 1
            echo "zenclock started"
        fi
        ;;
    stop)
        pkill -f "[c]onky .*conkyzenrc" 2>/dev/null
        pkill -f "zenclock/btnze[n]" 2>/dev/null
        echo "zenclock stopped"
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "usage: $0 {start|stop|restart}"
        ;;
esac