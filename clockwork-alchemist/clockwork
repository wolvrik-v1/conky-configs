#!/bin/bash
# clockwork — start/stop/restart wrapper for the Clockwork Alchemist

DIR="$HOME/.conky/clockwork-alchemist"
RC="$DIR/clockworkrc"
PP="[c]onky .*clockworkrc"

case "${1:-start}" in
    start)
        if pgrep -f "$PP" >/dev/null 2>&1; then
            echo "Already running."
        else
            setsid conky -d -c "$RC" </dev/null >"$DIR/conky.log" 2>&1 &
            sleep 1
            echo "Started."
        fi
        ;;
    stop)
        pkill -f "$PP" 2>/dev/null
        echo "Stopped."
        ;;
    restart)
        pkill -f "$PP" 2>/dev/null
        sleep 0.5
        setsid conky -d -c "$RC" </dev/null >"$DIR/conky.log" 2>&1 &
        sleep 1
        echo "Restarted."
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        ;;
esac