-- ############################################################
--  Pianobar Now Playing -- Conky config (MetalSysMonitor style)
--  Works in any corner: set alignment + gap_x/gap_y as desired.
--  All paths use environment variables — no hardcoded usernames.
-- ############################################################

local HOME       = os.getenv('HOME') or os.getenv('USERPROFILE') or ''
local XDG_CONFIG = os.getenv('XDG_CONFIG_HOME') or (HOME .. '/.config')
local LUA_PATH   = XDG_CONFIG .. '/metal-pianobar-conky/pianobar_now_playing.lua'

conky.config = {
    -- Update & performance
    update_interval       = 1,
    cpu_avg_samples       = 2,
    net_avg_samples       = 2,
    double_buffer         = true,
    no_buffers            = true,
    text_buffer_size      = 4096,
    imlib_cache_size      = 0,

    -- Window (desktop, transparent, click-through)
    own_window            = true,
    own_window_type       = 'desktop',
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value  = 0,
    own_window_colour      = '000000',
    own_window_hints       = 'undecorated,sticky,skip_taskbar,skip_pager,below',
    own_window_class       = 'ConkyPianobarNowPlaying',
    border_inner_margin    = 0,
    border_outer_margin    = 0,

    -- Size (design grid 640x340; scales with width)
    minimum_width         = 640,
    minimum_height        = 340,
    maximum_width         = 640,

    -- Position — CHANGE THESE TO MOVE THE PANEL
    -- alignment: top_left, top_right, bottom_left, bottom_right, top_middle, bottom_middle, middle_left, middle_right, middle
    alignment             = 'bottom_right',
    gap_x                 = 20,
    gap_y                 = 14,

    -- Drawing
    draw_shades           = false,
    draw_outline          = false,
    draw_borders          = false,
    draw_graph_borders    = false,

    -- Fonts (DejaVu matches MetalSysMonitor)
    use_xft               = true,
    font                  = 'DejaVu Sans:size=9',
    xftalpha              = 0.8,
    override_utf8_locale  = true,
    uppercase             = false,
    use_spacer            = 'left',

    -- Colors (unused by Lua renderer but kept for completeness)
    default_color         = 'E8ECEF',
    color1                = 'F2F5F7',
    color2                = '9AA4AC',
    color3                = 'CFD6DC',

    -- Lua
    lua_load              = LUA_PATH,
    lua_draw_hook_pre     = 'draw_now_playing',
}

-- Empty TEXT — everything drawn in Lua
conky.text = [[
]]
