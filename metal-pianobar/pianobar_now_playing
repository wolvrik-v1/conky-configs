#!/bin/bash
# Pianobar Now Playing start/stop/restart wrapper

DIR="${XDG_CONFIG_HOME:-$HOME/.config}/metal-pianobar-conky"
RC="$DIR/pianobar_now_playingrc"
LOG="${XDG_CACHE_HOME:-$HOME/.cache}/metal-pianobar-conky/pianobar_now_playing.log"

mkdir -p "$(dirname "$LOG")"

case "$1" in
    start)
        if pgrep -f "pianobar_now_playingrc" >/dev/null 2>&1; then
            echo "pianobar_now_playing already running"
        else
            setsid conky -d -c "$RC" </dev/null >>"$LOG" 2>&1 &
            disown
            sleep 1
            echo "pianobar_now_playing started"
        fi
        ;;
    stop)
        pkill -f "pianobar_now_playingrc" 2>/dev/null
        echo "pianobar_now_playing stopped"
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "usage: $0 {start|stop|restart}"
        ;;
esac
