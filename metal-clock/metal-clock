#!/bin/sh
# metal-clock - start / stop / restart the ORIGINAL-face clock widget
#
# The LED click button is now owned by conky itself: metal-clock.lua
# (spawn_button) launches/refreshes it whenever conky starts, and the
# button self-exits ~15s after conky disappears. So this wrapper only
# has to manage conky - usable with conky-manager as well.
#
#   metal-clock start      launch the conky widget (button auto-starts)
#   metal-clock stop       stop both
#   metal-clock restart    stop, then start again

DIR="$HOME/.conky/metal-clock"
LOG="$DIR/metal-clock.log"

start() {
    conky -d -c "$DIR/metal-clockrc" </dev/null >>"$LOG" 2>&1
}

stop() {
    pkill -f "[c]onky .*metal-clockrc" 2>/dev/null
    # dir-scoped pattern so we never touch clockwidget's button
    pkill -f "metal-clock/metal-cl[o]ck-btn" 2>/dev/null
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        sleep 1
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0