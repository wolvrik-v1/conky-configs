#!/bin/bash
# WindingRingsColorPianobar -- start / stop / restart the now-playing panel conky
# (album art + title/artist/album + progress; conky-only. The pianobar status
#  bridge in ~/.config/pianobar-widget/ is shared and is never touched here.)
set -u

DIR="$HOME/.conky/WindingRingsColorPianobar"
RC="$DIR/WindingRingsColorPianobar.conf"
LOG="$DIR/WindingRingsColorPianobar.log"
PAT='[c]onky .*WindingRingsColorPianobar\.conf'

start() {
    if pgrep -f "$PAT" >/dev/null 2>&1; then
        echo "WindingRingsColorPianobar already running"
        return 0
    fi
    setsid conky -d -c "$RC" </dev/null >>"$LOG" 2>&1 &
    disown
    echo "WindingRingsColorPianobar started"
}

stop() {
    pkill -f "$PAT" 2>/dev/null
    echo "WindingRingsColorPianobar stopped"
}

status() {
    if pgrep -f "$PAT" >/dev/null 2>&1; then
        echo "WindingRingsColorPianobar running (pid $(pgrep -f "$PAT" | head -1))"
    else
        echo "WindingRingsColorPianobar not running"
    fi
}

case "${1:-start}" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  status ;;
    *)       echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
