local HOME_DIR = os.getenv('HOME') or '.'
local BLANK = HOME_DIR .. '/.config/pickle-pianobar-widget/blank.png'

conky.config = {
    background = true,
    update_interval = 1,

    cpu_avg_samples = 2,
    net_avg_samples = 2,

    double_buffer = true,
    no_buffers = true,
    text_buffer_size = 4096,

    own_window = true,
    own_window_type = 'dock',
    own_window_class = 'Conky',
    own_window_title = 'Pickle Pianobar',
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value = 0,
    own_window_colour = '000000',
    own_window_hints = 'undecorated,sticky,skip_taskbar,skip_pager,below',

    alignment = 'bottom_left',
    gap_x = 10,
    gap_y = 20,

    minimum_width = 440,
    minimum_height = 290,

    border_inner_margin = 0,
    border_outer_margin = 0,

    draw_shades = false,
    draw_outline = false,
    draw_borders = false,
    draw_graph_borders = false,

    override_utf8_locale = true,
    use_xft = true,
    font = 'Ubuntu:size=10',

    lua_load = HOME_DIR
        .. '/.config/pickle-pianobar-widget/pickle_now_playing.lua',

    lua_draw_hook_pre = 'conky_render_panel',
}

-- The Lua renderer draws the panel and standby artwork. This transparent PNG
-- only pins the Conky dock window to the expected dimensions.
conky.text = '${image ' .. BLANK .. ' -p 0,0 -s 440x290}'
